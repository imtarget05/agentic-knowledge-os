# General Settings
APP_NAME="Agentic Knowledge OS"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# LLM Providers Configuration
# Supported: "gemini" | "openai" | "ollama"
PRIMARY_LLM_PROVIDER="gemini"

# API Keys (Fill in your own keys)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Local Ollama URL
OLLAMA_BASE_URL="http://localhost:11434"

# Model Versions
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBED_MODEL="text-embedding-3-small"
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_EMBED_MODEL="models/text-embedding-004"
OLLAMA_CHAT_MODEL="llama3"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Embeddings Engine Mode
# Supported: "local" (sentence-transformers) | "gemini" | "openai" | "ollama"
EMBEDDING_PROVIDER="local"
LOCAL_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Qdrant Vector Store Configuration
# Supported: "local" (uses file-backed client, no Docker required) | "server"
QDRANT_MODE="local"
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="agentic_knowledge_os"

# Hybrid RAG Configurations
HYBRID_ALPHA=0.5
TOP_K=8
USE_RERANKER=false

# Langfuse Observability Hooks
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"
